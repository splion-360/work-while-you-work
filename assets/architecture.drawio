        <mxCell id="split" value="&lt;b&gt;Graph-disjoint 3-fold split&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;near-duplicate resume and JD clusters&lt;br&gt;remain in one fold&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#FFF3D9;strokeColor=#B98525;fontColor=#17212B;fontSize=13;" vertex="1" parent="s1"><mxGeometry x="50" y="265" width="220" height="76" as="geometry"/></mxCell>

