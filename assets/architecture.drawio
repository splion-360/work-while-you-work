        <mxCell id="pairs" value="&lt;b&gt;Labeled resume/JD pairs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;No Fit · Potential Fit · Good Fit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#E8F1FB;strokeColor=#4B78A8;fontColor=#17212B;fontSize=13;" vertex="1" parent="s1"><mxGeometry x="50" y="55" width="220" height="62" as="geometry"/></mxCell>
