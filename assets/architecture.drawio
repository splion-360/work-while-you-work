        <mxCell id="soft-counts" value="&lt;b&gt;Per-JD-token&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;length-normalized&lt;br&gt;log soft counts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#FFF3D9;strokeColor=#B98525;fontColor=#17212B;fontSize=13;" vertex="1" parent="s3"><mxGeometry x="475" y="60" width="155" height="68" as="geometry"/></mxCell>
        <mxCell id="stats" value="&lt;b&gt;7 distribution statistics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mean · std · min · quartiles&lt;br&gt;median · max&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#FFF3D9;strokeColor=#B98525;fontColor=#17212B;fontSize=13;" vertex="1" parent="s3"><mxGeometry x="355" y="190" width="180" height="82" as="geometry"/></mxCell>
        <mxCell id="features" value="&lt;b&gt;77 pair features&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;11 kernels × 7 statistics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#F2ECF8;strokeColor=#8362A5;fontColor=#17212B;fontSize=13;" vertex="1" parent="s3"><mxGeometry x="115" y="200" width="170" height="62" as="geometry"/></mxCell>
