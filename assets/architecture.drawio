        <mxCell id="bge" value="&lt;b&gt;BGE-M3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;shared transformer&lt;br&gt;ColBERT projection&lt;br&gt;weights frozen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#FCE9E4;strokeColor=#B9634F;fontColor=#17212B;fontSize=13;" vertex="1" parent="s2"><mxGeometry x="350" y="135" width="135" height="108" as="geometry"/></mxCell>
        <mxCell id="resume-matrix" value="&lt;b&gt;Resume matrix R&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;normalized token vectors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#E7F4EC;strokeColor=#4C8B65;fontColor=#17212B;fontSize=13;" vertex="1" parent="s2"><mxGeometry x="350" y="45" width="135" height="58" as="geometry"/></mxCell>
