        <mxCell id="title" value="BGE-M3-based resume/JD scoring model training" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;fontColor=#17212B;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="850" height="35" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="BGE-M3 is frozen. This project trains and calibrates the downstream fit classifier." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#596674;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="850" height="24" as="geometry"/></mxCell>

