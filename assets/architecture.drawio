        <mxCell id="examples" value="&lt;b&gt;Fold-aware examples&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;77 features + binary label&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#E8F1FB;strokeColor=#4B78A8;fontColor=#17212B;fontSize=13;" vertex="1" parent="s4"><mxGeometry x="40" y="75" width="165" height="68" as="geometry"/></mxCell>
        <mxCell id="train" value="&lt;b&gt;Train partition&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;inner graph-disjoint split&lt;br&gt;fit scaler on train only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#FFF3D9;strokeColor=#B98525;fontColor=#17212B;fontSize=13;" vertex="1" parent="s4"><mxGeometry x="260" y="55" width="180" height="74" as="geometry"/></mxCell>
