        <mxCell id="resume-text" value="&lt;b&gt;Resume text&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;up to 8,192 tokens&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;fillColor=#E8F1FB;strokeColor=#4B78A8;fontColor=#17212B;fontSize=13;" vertex="1" parent="s2"><mxGeometry x="30" y="65" width="120" height="54" as="geometry"/></mxCell>
