        <mxCell id="s3" value="3 · TOKEN INTERACTION AND FEATURE MATERIALIZATION" style="swimlane;html=1;startSize=32;horizontal=1;rounded=0;fillColor=#F6F8FA;swimlaneFillColor=#FFFFFF;strokeColor=#AAB4BE;fontColor=#44515E;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="915" y="85" width="660" height="390" as="geometry"/></mxCell>
