{
  "manifest_version": 3,
  "name": "Resume Job Tracker",
  "version": "0.1.0",
  "description": "Select a resume and log the active job application.",
  "permissions": ["activeTab", "clipboardWrite", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "https://*.onrender.com/*"],
  "icons": {
    "16": "icons/resume-16.png",
    "32": "icons/resume-32.png",
    "48": "icons/resume-48.png",
    "128": "icons/resume-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/resume-16.png",
      "32": "icons/resume-32.png",
      "48": "icons/resume-48.png",
      "128": "icons/resume-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js", "settings.js", "score-display.js", "application-search.js", "password.js", "config.js", "icons/*.png", "icons/*.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["metadata.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
